<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
    </data>

    <!-- 退出对话框 - 占据右侧1/3屏幕 -->
    <LinearLayout
        android:id="@+id/exitDialogContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="afterDescendants">

        <!-- 左侧占位（占2/3，保持右侧原1/3宽度，不可见） -->
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2" />

        <!-- 右侧对话框内容（保持原占1/3宽度与大小） -->
        <LinearLayout
            android:id="@+id/exitDialogContent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#E6000000"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="afterDescendants">

            <!-- 顶部间距 -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <!-- 启动首页设置（只保留一个按钮） -->
            <Button
                android:id="@+id/btnStartToggle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="启动电视直播"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/menu_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:layout_marginBottom="10dp"
                android:nextFocusDown="@id/btnFavorite"
                android:nextFocusUp="@id/btnCancel" />


			<!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <!-- 画质列表（在收藏栏目上方，仅显示选项） -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/hzListInExit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:overScrollMode="never"/>

            <!-- 操作按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- 收藏按钮 -->
				<Button
                    android:id="@+id/btnFavorite"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="10dp"
                    android:text="收藏当前频道"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:background="@drawable/menu_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
					android:nextFocusUp="@id/btnStartToggle"
                    android:nextFocusDown="@id/btnCancel"
                    android:defaultFocusHighlightEnabled="true" />

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="取消"
                    android:textColor="#CCCCCC"
                    android:textSize="16sp"
                    android:background="@drawable/menu_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:clickable="true"
                    android:nextFocusUp="@id/btnFavorite"
                    android:nextFocusDown="@id/btnStartToggle" />
            </LinearLayout>

            <!-- 提示信息 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="再次按返回键退出应用"
                android:textColor="#999999"
                android:textSize="13sp"
                android:gravity="center" />

            <!-- 增删卜易系统链接（autoLink 使网址可点击跳转浏览器） -->
            <TextView
                android:id="@+id/tvZsbyLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="《增删卜易•六爻占卜系统》\nhttps://dxzsby.pages.dev"
                android:textColor="#4FA3FF"
                android:textSize="13sp"
                android:gravity="center"
                android:autoLink="web"
                android:linksClickable="true" />
        </LinearLayout>
    </LinearLayout>
</layout>